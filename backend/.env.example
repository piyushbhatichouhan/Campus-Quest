# Node Environment (production / development)
NODE_ENV=production

# Express Server Port (Render provides this automatically as PORT, default 5000)
PORT=5000

# Allowed CORS Origins (comma-separated list of approved frontend origins)
# For local development: http://localhost:5173,http://localhost:3000
# For production: https://YOUR-FRONTEND-URL.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Firebase Project Configuration
FIREBASE_PROJECT_ID=campusquest-877f2

# --- Firebase Admin Credentials (Choose Option A or Option B) ---

# Option A (Recommended for Render): Raw JSON string stored in Render Secret Environment Variable
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"campusquest-877f2",...}

# Option B (Local Development / Render Secret Files): Path to service account key JSON file
# GOOGLE_APPLICATION_CREDENTIALS=path/to/your-firebase-admin-key.json