rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Deny direct client-side read and write access to all documents by default.
    // All gameplay operations must be conducted through the authenticated Express backend
    // which uses the Firebase Admin SDK to bypass security rules securely.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
